{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Changes in Australian State Rankings for Visitor Arrivals (2020 to 2025)",
    "subtitle": "Annual short-term visitor arrivals by Australian state and territory"
  },

  "width": 650,
  "height": 420,
  "background": "white",

  "data": {
    "url": "data/visitor_arrivals_2020_2025.csv",
    "format": {
      "type": "csv"
    }
  },

  "transform": [
    {
      "window": [
        {
          "op": "rank",
          "field": "Visitor Arrivals",
          "as": "Rank"
        }
      ],
      "groupby": ["Year"],
      "sort": [
        {
          "field": "Visitor Arrivals",
          "order": "descending"
        }
      ]
    }
  ],

  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 75
    },
    "strokeWidth": 3
  },

  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year",
      "sort": "ascending",
      "axis": {
        "labelAngle": 0,
        "labelOverlap": false,
        "grid": false
      }
    },

    "y": {
      "field": "Rank",
      "type": "quantitative",
      "title": "Rank (1 = highest arrivals)",
      "scale": {
        "domain": [8.5, 0.5],
        "nice": false
      },
      "axis": {
        "values": [1, 2, 3, 4, 5, 6, 7, 8],
        "format": "d",
        "grid": true
      }
    },

    "color": {
      "field": "State",
      "type": "nominal",
      "title": "State / Territory",
      "scale": {
        "domain": [
          "NSW",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory",
          "ACT"
        ],
        "range": [
          "#4E79A7",
          "#F28E2B",
          "#B07AA1",
          "#E6AB02",
          "#76B7B2",
          "#E15759",
          "#9C755F",
          "#79706E"
        ]
      }
    },

    "detail": {
      "field": "State"
    },

    "order": {
      "field": "Year",
      "type": "quantitative"
    },

    "tooltip": [
      {
        "field": "State",
        "type": "nominal",
        "title": "State / Territory"
      },
      {
        "field": "Year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "Visitor Arrivals",
        "type": "quantitative",
        "title": "Visitor Arrivals",
        "format": ","
      },
      {
        "field": "Rank",
        "type": "quantitative",
        "title": "Rank"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 13,
      "gridColor": "#e6e6e6"
    },
    "legend": {
      "orient": "right",
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}