{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Top 10 Source Countries for Visitor Arrivals - July 2026",
    "fontSize": 20,
    "anchor": "middle"
  },

  "width": 900,
  "height": 500,

  "projection": {
    "type": "equalEarth"
  },

  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@3/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white"
      }
    },

    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@3/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },

      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/visitors_country.csv",
              "format": {
                "type": "csv"
              }
            },
            "key": "id",
            "fields": [
              "Country of Residence",
              "Jul-26"
            ]
          }
        },
        {
          "filter": "datum['Jul-26'] != null"
        },
        {
          "calculate": "toNumber(replace(datum['Jul-26'], ',', ''))",
          "as": "Visitors"
        },
        {
          "joinaggregate": [
            {
              "op": "min",
              "field": "Visitors",
              "as": "MinVisitors"
            },
            {
              "op": "max",
              "field": "Visitors",
              "as": "MaxVisitors"
            }
          ]
        },
        {
          "calculate": "(datum.Visitors - datum.MinVisitors) / (datum.MaxVisitors - datum.MinVisitors)",
          "as": "NormalizedVisitors"
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "white"
      },

      "encoding": {
        "color": {
          "field": "NormalizedVisitors",
          "type": "quantitative",
          "title": "Visitor Arrivals",
          "scale": {
            "domain": [0, 1],
            "scheme": "blues"
          },
          "legend": {
            "format": ".1f"
          }
        },

        "tooltip": [
          {
            "field": "Country of Residence",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Visitors",
            "type": "quantitative",
            "title": "Actual Visitor Arrivals",
            "format": ","
          },
          {
            "field": "NormalizedVisitors",
            "type": "quantitative",
            "title": "Normalized Value",
            "format": ".3f"
          }
        ]
      }
    }
  ]
}