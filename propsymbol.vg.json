{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "International Visitor Arrivals by Australian State - July 2026",
    "fontSize": 20,
    "anchor": "middle"
  },

  "width": 800,
  "height": 500,

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#bdbdbd",
        "stroke": "white",
        "strokeWidth": 1
      }
    },

    {
      "data": {
        "url": "data/visitors_state.csv",
        "format": {
          "type": "csv"
        }
      },

      "transform": [
        {
          "calculate": "datum.Region === 'New South Wales' ? 149.5 : datum.Region === 'Victoria' ? 144.9 : datum.Region === 'Queensland' ? 146.8 : datum.Region === 'South Australia' ? 135.5 : datum.Region === 'Western Australia' ? 122.0 : datum.Region === 'Tasmania' ? 146.7 : datum.Region === 'Northern Territory' ? 133.0 : 149.0",
          "as": "longitude"
        },
        {
          "calculate": "datum.Region === 'New South Wales' ? -32.5 : datum.Region === 'Victoria' ? -37.0 : datum.Region === 'Queensland' ? -22.0 : datum.Region === 'South Australia' ? -30.0 : datum.Region === 'Western Australia' ? -25.0 : datum.Region === 'Tasmania' ? -42.0 : datum.Region === 'Northern Territory' ? -19.0 : -35.5",
          "as": "latitude"
        }
      ],

      "mark": {
        "type": "circle",
        "opacity": 0.7,
        "stroke": "white",
        "strokeWidth": 1.5,
        "color": "#E69F00"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "Number of visitor arrivals",
          "type": "quantitative",
          "title": "Visitor Arrivals",
          "scale": {
            "range": [
              50,
              2500
            ]
          },
          "legend": {
            "title": "Visitor Arrivals",
            "values": [
              50000,
              100000,
              150000,
              200000
            ],
            "format": ",.0f"
          }
        },

        "tooltip": [
          {
            "field": "Region",
            "type": "nominal",
            "title": "State/Territory"
          },
          {
            "field": "Number of visitor arrivals",
            "type": "quantitative",
            "title": "Visitor Arrivals",
            "format": ","
          }
        ]
      }
    }
  ]
}